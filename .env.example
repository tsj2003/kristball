# Copy to .env in the repo root and in backend/ (Prisma reads backend/.env).

# Local Postgres via docker compose (default):
DATABASE_URL=postgresql://kristallball:kristallball_dev@localhost:5432/kristallball

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=4522
CORS_ORIGIN=*

# Frontend (copy to frontend/.env for production builds).
# Dev: leave as /api so Vite proxies to the Express API.
VITE_API_BASE_URL=/api

# Optional. Public health URL used when the API is already running on Render/Railway.
# KEEP_AWAKE_URL=https://your-service.onrender.com/api/health
